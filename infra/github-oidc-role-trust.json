{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsObservabilityEks",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::027024089660:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:lurantDoh/observability-eks:*",
            "repo:lurantDoh@*/observability-eks@*:*"
          ]
        }
      }
    }
  ]
}
